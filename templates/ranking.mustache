{{!
    @template mod_rank/ranking

    Example context (json):
    {
    }
}}
<div class="mod-rank">
    {{#instructions}}
        <div class="mb-3">{{{instructions}}}</div>
    {{/instructions}}

    {{#hasresponse}}
        <div class="alert alert-info">{{#str}}yourranking, rank{{/str}}</div>
    {{/hasresponse}}

    <ol id="rank-list" class="list-group list-group-numbered mb-3" data-editable="{{#canedit}}1{{/canedit}}{{^canedit}}0{{/canedit}}">
        {{#items}}
            <li class="list-group-item d-flex align-items-center gap-2" data-itemid="{{id}}" {{#canedit}}draggable="true" tabindex="0"{{/canedit}}>
                {{#canedit}}<span class="rank-handle" aria-hidden="true">&#9776;</span>{{/canedit}}
                <span class="flex-grow-1">{{content}}</span>
            </li>
        {{/items}}
    </ol>

    {{#canedit}}
        <form method="post" action="{{action}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" id="rank-order" name="order" value="{{order}}">
            <button type="submit" class="btn btn-primary">{{submitlabel}}</button>
        </form>
        <p class="text-muted small mt-2">{{#str}}draghelp, rank{{/str}}</p>
    {{/canedit}}
</div>
